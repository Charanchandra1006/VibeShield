{
  "name": "vibeshield",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "pnpm --filter @vibeshield/database run db:push",
    "db:generate": "pnpm --filter @vibeshield/database run db:generate"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.11.0"
}
